{
  "expo": {
    "name": "Soundoc",
    "slug": "soundoc",
    "scheme": "soundoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "usesIcloudStorage": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "bundleIdentifier": "com.lecoffeeconfit.soundoc",
      "buildNumber": "14"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Soundoc uses your photos only when you choose an image to turn into private listening text.",
          "cameraPermission": "Soundoc uses the camera only when you choose to scan text into private listening text.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.lecoffeeconfit.soundoc",
            "activationRule": {
              "supportsWebPageWithMaxCount": 1,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true,
              "supportsFileWithMaxCount": 1,
              "supportsAttachmentsWithMaxCount": 1,
              "supportsImageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/uri-list",
              "text/markdown",
              "text/html",
              "text/rtf",
              "application/rtf",
              "application/pdf",
              "application/epub+zip",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111417",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111417",
            "image": "./assets/icon.png"
          }
        }
      ],
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "color": "#FF7138",
          "defaultChannel": "soundoc-reading"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "android": {
      "package": "com.lecoffeeconfit.soundoc",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6e90fa35-e060-4749-9663-b1a122f81fe1"
      }
    }
  }
}
